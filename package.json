{
  "name": "certchain-open",
  "version": "1.0.0",
  "private": true,
  "description": "Open source platform for academic certificate issuance and verification on blockchain",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @certchain/shared build && node scripts/dev.mjs",
    "setup:local-blockchain": "node scripts/setup-local-blockchain.mjs",
    "deploy:gcp:setup": "bash infra/gcp/setup.sh",
    "deploy:gcp": "bash infra/gcp/deploy.sh",
    "deploy:gcp:seed": "bash infra/gcp/seed.sh",
    "deploy:gcp:rotate-secrets": "bash infra/gcp/rotate-secrets.sh",
    "deploy:gcp:setup-github-wif": "bash infra/gcp/setup-github-wif.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,sol}\"",
    "test": "pnpm -r test",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @certchain/shared build && changeset publish",
    "publish:shared": "pnpm --filter @certchain/shared publish --access public --no-git-checks",
    "publish:shared:dry-run": "pnpm --filter @certchain/shared publish --dry-run --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.sol": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
