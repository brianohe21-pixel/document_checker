# Copy to secrets.env (gitignored) and fill with production values.
# Used by setup.sh to create Secret Manager entries.

DB_PASSWORD=change-me-strong-db-password

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password

# Polygon Amoy (or your target network)
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=0xYourWalletPrivateKey
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=CertChain <certificates@yourdomain.com>

# Admin panel URL (for CORS and public web links)
ADMIN_URL=https://certchain-adm-xxx.run.app
