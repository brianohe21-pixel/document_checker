# Database
DATABASE_URL=postgresql://certchain:certchain@localhost:5432/certchain

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Admin seed (use strong unique values; never commit real credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password

# Blockchain — local dev (Hardhat node via pnpm dev)
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
CONTRACT_ADDRESS=
# Run after pnpm dev is up: pnpm setup:local-blockchain

# Blockchain — Polygon Amoy testnet (deploy:amoy / production API)
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# AMOY_PRIVATE_KEY=          # wallet with Amoy MATIC (never use Hardhat dev key)
# CONTRACT_ADDRESS=
# POLYGONSCAN_API_KEY=

# App URLs
PUBLIC_VERIFY_URL=http://localhost:3000/verify
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=CertChain <onboarding@resend.dev>

# Donations (optional)
NEXT_PUBLIC_DONATE_GITHUB_URL=
NEXT_PUBLIC_DONATE_CRYPTO_ADDRESS=
NEXT_PUBLIC_DONATE_CRYPTO_LABEL=Polygon
NEXT_PUBLIC_DONATE_KOFI_URL=

# Contact (optional overrides)
NEXT_PUBLIC_CONTACT_NAME=Brayan Riaño
NEXT_PUBLIC_CONTACT_WHATSAPP=573223117078

# Redis (bulk jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
BULK_CONCURRENCY=3
BULK_TX_DELAY_MS=1000

# API
PORT=3001
